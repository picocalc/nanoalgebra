{
  "name": "nanoalgebra",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picocalc/nanoalgebra.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#src": "./src/index.ts",
    "#lib/*": "./src/lib/*.ts",
