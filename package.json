    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test --dots",
    "lint": "oxlint",
    "format": "oxfmt",
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "bigint.bitlength": "0.3.0"
  },
  "devDependencies": {
    "@gameroman/config": "0.3.0",
    "@types/bun": "1.4.4",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsdown": "0.23.7",
    "typescript": "7.0.2"
  }
}
